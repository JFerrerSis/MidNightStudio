---
// src/components/ui/ProductCard.astro
import type { Product } from '../../types/product'; 
// Importamos el icono desde la librería
import { ShoppingCart } from 'lucide-astro';

interface Props extends Product {}
const { id, nombre, precio, imagen, categoria } = Astro.props;

const productData = JSON.stringify({ id, nombre, precio, imagen, categoria });
---

<div class="group relative bg-[#0d0e12]/90 border border-white/10 p-4 md:p-5 rounded-2xl hover:border-neon-green/40 transition-all duration-500 shadow-xl overflow-hidden flex flex-col h-full hover:shadow-[0_20px_50px_rgba(0,0,0,0.8)]">
  
  <a href={`/catalogo/producto/${id}`} class="absolute inset-0 z-10" aria-label={`Ver detalles de ${nombre}`}></a>

  <div class="absolute inset-0 bg-linear-to-b from-transparent via-neon-green/10 to-transparent -translate-y-full group-hover:animate-scan pointer-events-none z-0 opacity-0 group-hover:opacity-100"></div>

  <div class="relative aspect-square mb-4 md:mb-5 overflow-hidden bg-black/60 border border-white/5 rounded-xl shrink-0">
    <img 
      src={imagen} 
      alt={nombre} 
      loading="lazy"
      decoding="async"
      class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-110"
      style={`view-transition-name: card-${id};`} 
    />
    
    <div class="absolute top-2 left-2 bg-black/90 border border-neon-green/30 px-3 py-1 z-20 rounded-full">
      <p class="text-[7px] md:text-[9px] font-mono text-neon-green tracking-widest uppercase font-bold">
        {categoria}
      </p>
    </div>
  </div>

  <div class="flex flex-col flex-1 relative z-20">
    <h3 class="text-sm md:text-base lg:text-lg font-bold text-white uppercase tracking-normal leading-tight group-hover:text-neon-green transition-colors line-clamp-2 min-h-10 md:min-h-12">
      {nombre}
    </h3>
    
    <div class="flex items-center justify-between pt-4 border-t border-white/10 mt-auto gap-2">
      <div class="flex flex-col">
        <span class="text-[9px] font-mono text-white/30 uppercase tracking-widest leading-none mb-1">Precio</span>
        <span class="text-base md:text-xl font-mono font-bold text-white tracking-tighter">
          ${precio.toFixed(2)}
        </span>
      </div>
      
      <button 
        type="button"
        class="add-to-cart-btn relative z-30 bg-neon-green text-black p-3 md:p-3.5 hover:bg-white transition-all active:scale-90 shadow-[0_5px_15px_rgba(0,245,212,0.2)] flex items-center justify-center rounded-xl group/btn"
        data-product={productData}
        aria-label="Añadir al carrito"
      >
        <ShoppingCart 
          size={20} 
          strokeWidth={2.5} 
          class="transition-transform group-hover/btn:scale-110" 
        />
      </button>
    </div>
  </div>
</div>

<style>
  @keyframes scan {
    0% { transform: translateY(-100%); }
    100% { transform: translateY(100%); }
  }
  .animate-scan {
    animation: scan 3s linear infinite;
  }
  
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>