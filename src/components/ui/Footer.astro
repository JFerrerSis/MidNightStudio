---
// src/components/layout/Footer.astro
import { Github, Linkedin, Instagram, Cpu } from 'lucide-astro';

const year = new Date().getFullYear();
// Configuración de links
const githubUrl = "https://github.com/JFerrerSis"; 
const instagramUrl = "https://www.instagram.com/jferr3r?igsh=ZDVjenVwcGNqM3pv";
const linkedinUrl = "https://www.linkedin.com/in/jorge-ferrer-8a167930b?utm_source=share&utm_campaign=share_via&utm_content=profile&utm_medium=android_app";
---

<footer class="w-full pb-12 pt-10 text-center font-mono uppercase italic border-t border-white/5 bg-black/40 backdrop-blur-md relative z-20 overflow-hidden">
  <div class="absolute inset-0 bg-linear-to-b from-transparent to-neon-green/2 pointer-events-none"></div>

  <div class="max-w-6xl mx-auto px-6 flex flex-col items-center gap-6 relative z-10">
    
    <div class="flex items-center gap-8 mb-2">
      <a href={githubUrl} target="_blank" class="group text-white/20 hover:text-white transition-all duration-300" title="GitHub">
        <Github size={20} strokeWidth={1.5} class="group-hover:drop-shadow-[0_0_8px_rgba(255,255,255,0.5)] group-hover:scale-110 transition-all" />
      </a>

      <a href={linkedinUrl} target="_blank" class="group text-white/20 hover:text-neon-green transition-all duration-300" title="LinkedIn">
        <Linkedin size={20} strokeWidth={1.5} class="group-hover:drop-shadow-[0_0_8px_rgba(0,245,212,0.5)] group-hover:scale-110 transition-all" />
      </a>

      <a href={instagramUrl} target="_blank" class="group text-white/20 hover:text-pink-500 transition-all duration-300" title="Instagram">
        <Instagram size={20} strokeWidth={1.5} class="group-hover:drop-shadow-[0_0_8px_rgba(236,72,153,0.5)] group-hover:scale-110 transition-all" />
      </a>
    </div>

    <div class="space-y-3">
      <div class="flex items-center justify-center gap-2 text-neon-green/60">
        <Cpu size={12} class="animate-pulse" />
        <p class="text-[10px] md:text-[11px] font-black tracking-[0.3em]">
          SYSTEM_STATUS: <span class="text-white">OPERATIONAL</span>
        </p>
      </div>

      <p class="text-[9px] md:text-[10px] text-white/40 font-bold tracking-[0.2em]">
        DESIGNED_BY: 
        <a href={githubUrl} target="_blank" class="text-white hover:text-neon-green transition-colors decoration-neon-green/30 underline underline-offset-4 decoration-2">
          J. FERRER
        </a> 
        <span class="text-white/10 mx-2">//</span> 
        <span>MIDNIGHT_CORE_v2.0</span>
      </p>
      
      <div class="flex items-center justify-center gap-3 text-[8px] text-white/20 tracking-[0.4em] font-medium bg-white/5 px-4 py-1.5 rounded-full border border-white/5">
        <span>EST {year}</span>
        <span class="w-1 h-1 bg-white/10 rounded-full"></span>
        <span>MARACAIBO</span>
        <span class="w-1 h-1 bg-white/10 rounded-full"></span>
        <span>VENEZUELA</span>
      </div>
    </div>

    <div class="h-1 w-16 bg-linear-to-r from-transparent via-neon-green/30 to-transparent rounded-full"></div>
  </div>
</footer>

<style>
  footer {
    /* Asegura que el footer se sienta parte del scroll fluido */
    contain: paint;
  }
</style>