---
// src/components/layout/Header.astro
import { ShoppingBag, Zap } from 'lucide-astro';
---

<nav class="fixed top-0 w-full z-50 bg-[#08090d]/80 backdrop-blur-xl border-b border-white/5 transition-all duration-300" id="main-nav">
  <div class="max-w-7xl mx-auto px-6 h-20 flex justify-between items-center transition-all duration-300" id="nav-container">
    
    <a href="/" class="flex items-center gap-2 group transition-transform active:scale-95">
      <div class="bg-neon-green p-1 rounded-lg group-hover:rotate-12 transition-transform duration-300">
        <Zap size={18} fill="black" class="text-black" />
      </div>
      <span class="font-black italic text-xl md:text-2xl tracking-tighter text-white uppercase">
        MIDNIGHT<span class="text-neon-green group-hover:drop-shadow-[0_0_8px_rgba(0,245,212,0.5)] transition-all">STUDIO</span>
      </span>
    </a>

    <button 
      id="cart-trigger" 
      class="relative p-3 bg-white/5 hover:bg-neon-green/10 border border-white/10 hover:border-neon-green/40 transition-all rounded-xl group outline-none"
      aria-label="Abrir Carrito"
    >
      <div class="absolute inset-0 bg-neon-green/5 opacity-0 group-hover:opacity-100 transition-opacity rounded-xl"></div>
      
      <ShoppingBag 
        size={22} 
        strokeWidth={2} 
        class="text-white/70 group-hover:text-neon-green transition-colors relative z-10" 
      />

      <span 
        id="cart-counter" 
        class="absolute -top-1.5 -right-1.5 bg-neon-green text-black font-mono font-black text-[10px] min-w-[20px] h-[20px] flex items-center justify-center rounded-full scale-0 transition-all duration-300 shadow-[0_0_15px_rgba(0,245,212,0.4)] border-2 border-[#08090d] z-20"
      >
        0
      </span>
    </button>
  </div>
</nav>

<script>
  import { cartItems, isCartOpen } from '../../store/cartStore';

  const initHeader = () => {
    const trigger = document.querySelector('#cart-trigger');
    const counter = document.querySelector('#cart-counter');
    const nav = document.querySelector('#main-nav');
    const container = document.querySelector('#nav-container');

    if (!trigger) return;

    const unsubscribe = cartItems.subscribe(items => {
      const total = items.reduce((acc, item) => acc + (item.cantidad || 0), 0);
      if (counter) {
        counter.textContent = total.toString();
        if (total > 0) {
          counter.classList.add('scale-100');
        } else {
          counter.classList.remove('scale-100');
        }
      }
    });

    const toggleCart = (e: Event) => {
      e.preventDefault();
      e.stopImmediatePropagation();
      isCartOpen.set(true);
    };

    trigger.addEventListener('click', toggleCart);

    const handleScroll = () => {
      if (window.scrollY > 20) {
        nav?.classList.add('bg-[#08090d]/95', 'border-white/10');
        container?.classList.replace('h-20', 'h-16');
      } else {
        nav?.classList.remove('bg-[#08090d]/95', 'border-white/10');
        container?.classList.replace('h-16', 'h-20');
      }
    };
    window.addEventListener('scroll', handleScroll);

    document.addEventListener('astro:before-preparation', () => {
      unsubscribe();
      trigger.removeEventListener('click', toggleCart);
      window.removeEventListener('scroll', handleScroll);
    }, { once: true });
  };

  document.addEventListener('astro:page-load', initHeader);
</script>

<style>
  #main-nav {
    backdrop-filter: blur(12px) saturate(180%);
  }
  
  #cart-counter {
    will-change: transform;
    /* Evita que el texto se vea borroso en la animación */
    backface-visibility: hidden;
    /* Asegura que el número esté perfectamente centrado */
    line-height: 1;
    padding-top: 1px;
  }
</style>