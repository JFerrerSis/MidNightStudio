---
// src/components/cart/CartDrawer.astro
import { 
  X, User, CreditCard, ShoppingBag 
} from 'lucide-astro';
---

<div id="cart-overlay" class="fixed inset-0 bg-black/80 backdrop-blur-md z-60 hidden opacity-0 transition-opacity duration-500"></div>

<div id="cart-drawer" class="fixed inset-y-0 right-0 w-full md:max-w-sm bg-[#08090d] border-l border-white/10 z-70 translate-x-full transition-transform duration-500 flex flex-col shadow-[-20px_0_50px_rgba(0,0,0,0.9)] h-vh">
  
  <div class="p-6 border-b border-white/5 flex justify-between items-center bg-black/40 shrink-0">
    <div class="flex items-center gap-3">
      <div class="text-neon-green">
        <ShoppingBag size={18} strokeWidth={2.5} />
      </div>
      <h2 class="font-mono text-white text-[11px] uppercase tracking-[0.2em] font-black">Mi Carrito</h2>
    </div>
    <button id="close-cart" class="group flex items-center gap-2 text-white/30 hover:text-neon-green transition-all">
      <span class="font-mono text-[10px] tracking-widest uppercase">Cerrar</span>
      <X size={18} strokeWidth={2} class="group-hover:rotate-90 transition-transform" />
    </button>
  </div>

  <div id="cart-items" class="flex-1 overflow-y-auto p-6 space-y-4 custom-scrollbar overscroll-contain"></div>

  <div id="order-form" class="px-6 py-5 border-t border-white/5 bg-white/2 space-y-4 hidden animate-fade-in shrink-0">
    <div class="space-y-3">
      <div class="flex items-center gap-2 mb-1">
        <User size={14} class="text-neon-green" />
        <h3 class="font-mono text-[10px] text-white/60 tracking-widest uppercase font-bold">Datos de Entrega</h3>
      </div>
      
      <input type="text" id="cust-name" placeholder="NOMBRE COMPLETO" class="w-full bg-black/40 border border-white/10 p-3 text-[10px] font-mono focus:border-neon-green/50 rounded-xl outline-none text-white transition-all uppercase" />
      
      <div class="grid grid-cols-2 gap-3">
        <input type="tel" id="cust-id" placeholder="CÉDULA / ID" class="bg-black/40 border border-white/10 p-3 text-[10px] font-mono rounded-xl outline-none focus:border-neon-green/50 text-white transition-all uppercase" />
        <input type="tel" id="cust-phone" placeholder="TELÉFONO" class="bg-black/40 border border-white/10 p-3 text-[10px] font-mono rounded-xl outline-none focus:border-neon-green/50 text-white transition-all uppercase" />
      </div>

      <select id="cust-delivery" class="w-full bg-black/60 border border-white/10 p-3 text-[10px] font-mono rounded-xl outline-none focus:border-neon-green/50 text-white/80 appearance-none uppercase">
        <option value="PICKUP">Retiro en tienda (Pickup)</option>
        <option value="DELIVERY">Envío a domicilio (Delivery)</option>
      </select>

      <textarea id="cust-address" placeholder="DIRECCIÓN DETALLADA..." class="w-full bg-black/40 border border-white/10 p-3 text-[10px] font-mono rounded-xl outline-none h-16 focus:border-neon-green/50 text-white transition-all resize-none hidden uppercase"></textarea>
    </div>

    <div class="space-y-3 pt-2">
      <div class="flex items-center gap-2 mb-1">
        <CreditCard size={14} class="text-neon-green" />
        <h3 class="font-mono text-[10px] text-white/60 tracking-widest uppercase font-bold">Método de Pago</h3>
      </div>
      <select id="cust-payment" class="w-full bg-black/60 border border-white/10 p-3 text-[10px] font-mono rounded-xl outline-none focus:border-neon-green/50 text-white/80 appearance-none uppercase">
          <option value="PAGO MÓVIL">💸 Pago Móvil</option>
          <option value="ZELLE">💎 Zelle</option>
          <option value="EFECTIVO">💵 Efectivo (USD/BS)</option>
      </select>
    </div>
  </div>

  <div class="p-6 border-t border-white/5 bg-black/60 shrink-0">
    <div class="flex justify-between items-center mb-6">
      <span class="font-mono text-[10px] text-white/40 uppercase tracking-widest">Total Estimado</span>
      <span id="total-amount" class="text-neon-green font-black text-3xl tracking-tighter">$0.00</span>
    </div>
    <button id="send-whatsapp" class="w-full bg-neon-green text-black py-5 rounded-xl font-black uppercase italic text-[11px] tracking-[0.2em] hover:bg-white transition-all active:scale-95 shadow-[0_10px_20px_rgba(0,245,212,0.15)] disabled:opacity-20 disabled:grayscale" disabled>
      Confirmar Pedido por WhatsApp
    </button>
  </div>
</div>

<script>
  import { 
    cartItems, isCartOpen, cartTotal, 
    increaseQuantity, decreaseQuantity, removeFromCart, 
    customerData, sendOrderToWhatsApp 
  } from '../../store/cartStore';

  declare global {
    interface Window {
      midnightToast: (message: string, type?: 'success' | 'error' | 'warning') => void;
      changeQty: (id: string, delta: number) => void;
      removeItem: (id: string, nombre: string) => void;
    }
  }

  const initCart = () => {
    const drawer = document.getElementById('cart-drawer');
    const overlay = document.getElementById('cart-overlay');
    const closeBtn = document.getElementById('close-cart');
    const itemsContainer = document.getElementById('cart-items');
    const totalEl = document.getElementById('total-amount');
    const orderForm = document.getElementById('order-form');
    const whatsappBtn = document.getElementById('send-whatsapp') as HTMLButtonElement;
    const body = document.body; // Referencia al body

    // --- 1. Sincronización de Apertura (Bloqueo de scroll añadido) ---
    const unsubsOpen = isCartOpen.subscribe(open => {
      if (open) {
        overlay?.classList.remove('hidden');
        body.style.overflow = 'hidden'; // Bloquea scroll
        setTimeout(() => {
          overlay?.classList.replace('opacity-0', 'opacity-100');
          drawer?.classList.remove('translate-x-full');
        }, 10);
      } else {
        drawer?.classList.add('translate-x-full');
        overlay?.classList.replace('opacity-100', 'opacity-0');
        body.style.overflow = ''; // Libera scroll
        setTimeout(() => overlay?.classList.add('hidden'), 500);
      }
    });

    if (closeBtn) closeBtn.onclick = () => isCartOpen.set(false);
    if (overlay) overlay.onclick = () => isCartOpen.set(false);

    // --- 2. Renderizado de Items ---
    const unsubsItems = cartItems.subscribe(items => {
      if (!itemsContainer || !totalEl || !orderForm || !whatsappBtn) return;

      if (items.length === 0) {
        itemsContainer.innerHTML = `
          <div class="flex flex-col items-center justify-center h-full text-white/20 space-y-4">
             <p class="font-mono text-[10px] uppercase tracking-widest italic">// Carrito Vacío</p>
          </div>
        `;
        orderForm.classList.add('hidden');
        whatsappBtn.disabled = true;
        return;
      }

      orderForm.classList.remove('hidden');
      whatsappBtn.disabled = false;

      itemsContainer.innerHTML = items.map(item => `
        <div class="flex gap-4 bg-white/5 border border-white/5 p-3 rounded-2xl group transition-all hover:border-neon-green/20">
          <img src="${item.imagen}" class="w-16 h-16 object-cover rounded-xl border border-white/5" />
          <div class="flex-1 flex flex-col justify-between">
            <div class="flex justify-between items-start">
              <h4 class="text-[10px] font-black uppercase text-white tracking-tighter w-full pr-4 leading-tight">${item.nombre}</h4>
              <button onclick="window.removeItem('${item.id}', '${item.nombre}')" class="text-white/20 hover:text-red-500 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
              </button>
            </div>
            <div class="flex justify-between items-center">
              <span class="font-mono text-neon-green font-bold">$${(item.precio * item.cantidad).toFixed(2)}</span>
              <div class="flex items-center gap-3 bg-black/40 rounded-lg px-2 py-1 border border-white/10">
                <button onclick="window.changeQty('${item.id}', -1)" class="text-white/40 hover:text-neon-green transition-colors">-</button>
                <span class="text-[10px] font-mono text-white/80">${item.cantidad}</span>
                <button onclick="window.changeQty('${item.id}', 1)" class="text-white/40 hover:text-neon-green transition-colors">+</button>
              </div>
            </div>
          </div>
        </div>
      `).join('');
    });

    const unsubsTotal = cartTotal.subscribe(val => {
      if (totalEl) totalEl.textContent = `$${val.toFixed(2)}`;
    });

    const updateForm = () => {
      const deliveryEl = document.getElementById('cust-delivery') as HTMLSelectElement;
      const addrEl = document.getElementById('cust-address') as HTMLTextAreaElement;
      
      if (deliveryEl.value === 'DELIVERY') {
        addrEl?.classList.remove('hidden');
      } else {
        addrEl?.classList.add('hidden');
      }

      customerData.set({
        nombre: (document.getElementById('cust-name') as HTMLInputElement).value,
        cedula: (document.getElementById('cust-id') as HTMLInputElement).value,
        telefono: (document.getElementById('cust-phone') as HTMLInputElement).value,
        direccion: addrEl.value,
        metodoEntrega: deliveryEl.value as 'DELIVERY' | 'PICKUP',
        metodoPago: (document.getElementById('cust-payment') as HTMLSelectElement).value,
      });
    };

    ['cust-name', 'cust-id', 'cust-phone', 'cust-delivery', 'cust-address', 'cust-payment'].forEach(id => {
      document.getElementById(id)?.addEventListener('input', updateForm);
    });

    if (whatsappBtn) {
      whatsappBtn.onclick = () => {
        updateForm();
        sendOrderToWhatsApp();
      };
    }

    window.changeQty = (id, delta) => delta > 0 ? increaseQuantity(id) : decreaseQuantity(id);
    window.removeItem = (id, nombre) => {
      removeFromCart(id);
      window.midnightToast?.(`${nombre} ELIMINADO`, 'error');
    };

    document.addEventListener('astro:before-preparation', () => {
      unsubsOpen();
      unsubsItems();
      unsubsTotal();
      body.style.overflow = ''; // Asegurar liberación en navegación
    }, { once: true });
  };

  document.addEventListener('astro:page-load', initCart);
</script>

<style>
  .custom-scrollbar::-webkit-scrollbar { width: 3px; }
  .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(0, 245, 212, 0.2); border-radius: 10px; }
  
  /* Evita el scroll encadenado al fondo en móviles */
  .overscroll-contain { overscroll-behavior: contain; }

  @keyframes quickFade { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }
  .animate-fade-in { animation: quickFade 0.3s ease-out; }
</style>