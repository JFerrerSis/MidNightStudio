---
import CatalogLayout from '../layouts/CatalogoLayout.astro';
import ProductCard from '../components/ui/ProductCard.astro';
import ProductSkeleton from '../components/ui/ProductSkeleton.astro'; 
import ParticlesBg from '../components/ui/ParticlesBackground.astro';
import productos from '../data/productos.json'; 
import type { Product } from '../types/product';

// 1. Añadimos Search a los iconos
import { Grid2X2, Filter, Search } from 'lucide-astro';

const products = (productos as Product[]);
const categories = ["TODOS", ...new Set(products.map(p => p.categoria.toUpperCase()))];
---

<CatalogLayout title="Catálogo | MidNight Studio">
  <ParticlesBg />

  <main class="max-w-7xl mx-auto px-4 md:px-6 pt-24 md:pt-32 pb-24 relative z-10">
    
    <header class="mb-8 md:mb-16 border-l-4 border-neon-green pl-5 md:pl-8 opacity-0 animate-slide-in">
      <div class="flex items-center gap-3 mb-2">
        <Grid2X2 size={20} class="text-neon-green/60" strokeWidth={1.5} />
      </div>
      <h1 class="text-4xl md:text-7xl font-black italic uppercase tracking-tighter leading-none text-white">
        Catálogo
      </h1>
    </header>

    <div class="flex flex-col items-center mb-12 md:mb-20 space-y-8">
      
      <div class="w-full max-w-md relative group opacity-0 animate-slide-in" style="animation-delay: 0.1s">
        <div class="absolute inset-y-0 left-4 flex items-center pointer-events-none text-white/20 group-focus-within:text-neon-green transition-colors">
          <Search size={18} />
        </div>
        <input 
          type="text" 
          id="product-search"
          placeholder="BUSCAR.."
          class="w-full bg-black/40 border border-white/10 py-4 pl-12 pr-4 rounded-2xl text-white font-mono text-xs tracking-widest outline-none focus:border-neon-green/40 focus:bg-neon-green/5 transition-all placeholder:text-white/10 uppercase"
        />
        <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-px bg-neon-green group-focus-within:w-full transition-all duration-500 shadow-[0_0_8px_#00f5d4]"></div>
      </div>

      <div class="flex flex-wrap justify-center gap-3 md:gap-4 opacity-0 animate-slide-in" style="animation-delay: 0.15s">
        {categories.map((cat) => (
          <button 
            class="filter-btn group relative px-6 md:px-10 py-2.5 md:py-3.5 border border-white/10 bg-black/40 backdrop-blur-sm hover:border-neon-green/60 transition-all duration-300 rounded-full overflow-hidden"
            data-category={cat}
          >
            <div class="absolute inset-0 bg-neon-green/0 group-hover:bg-neon-green/10 transition-colors"></div>
            <span class="relative z-10 font-mono text-[10px] md:text-[12px] text-white/50 group-hover:text-neon-green transition-colors uppercase tracking-[0.15em] font-bold">
              {cat}
            </span>
          </button>
        ))}
      </div>
    </div>

    <div id="product-grid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-x-8 md:gap-y-14">
      {/* Skeletons */}
      {Array.from({ length: 8 }).map((_, i) => (
        <div class="skeleton-wrapper hidden-instant">
          <ProductSkeleton />
        </div>
      ))}

      {/* Items Reales */}
      {products.map((item, index) => (
        <div 
          class="product-item opacity-0 animate-fade-up" 
          data-category={item.categoria.toUpperCase()}
          data-name={item.nombre.toUpperCase()}
          style={`animation-delay: ${0.2 + (index * 0.05)}s;`} 
        >
          <ProductCard {...item} />
        </div>
      ))}
    </div>
  </main>
</CatalogLayout>

<script>
  const initFilters = () => {
    const buttons = document.querySelectorAll('.filter-btn');
    const items = document.querySelectorAll('.product-item');
    const skeletons = document.querySelectorAll('.skeleton-wrapper');
    const searchInput = document.getElementById('product-search') as HTMLInputElement;

    let currentCategory = 'TODOS';
    let currentSearch = '';

    const applyFilters = () => {
      items.forEach((item) => {
        const itemCat = item.getAttribute('data-category') || '';
        const itemName = item.getAttribute('data-name') || '';
        
        const matchesCategory = currentCategory === 'TODOS' || itemCat === currentCategory;
        const matchesSearch = itemName.includes(currentSearch.toUpperCase());

        const el = item as HTMLElement;
        el.style.animation = 'none';
        el.style.opacity = '1';

        if (matchesCategory && matchesSearch) {
          el.classList.remove('hidden-instant');
        } else {
          el.classList.add('hidden-instant');
        }
      });
      skeletons.forEach(s => s.classList.add('hidden-instant'));
    };

    // Evento de búsqueda
    searchInput?.addEventListener('input', (e) => {
      currentSearch = (e.target as HTMLInputElement).value;
      applyFilters();
    });

    // Evento de botones de categoría
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        currentCategory = btn.getAttribute('data-category') || 'TODOS';
        
        buttons.forEach(b => {
           b.classList.remove('border-neon-green', 'bg-neon-green/10');
           b.querySelector('span')?.classList.replace('text-neon-green', 'text-white/50');
        });
        
        btn.classList.add('border-neon-green', 'bg-neon-green/10');
        btn.querySelector('span')?.classList.replace('text-white/50', 'text-neon-green');

        // Efecto visual de carga
        items.forEach(i => i.classList.add('hidden-instant'));
        skeletons.forEach(s => s.classList.remove('hidden-instant'));

        setTimeout(() => {
          // @ts-ignore
          if (!document.startViewTransition) {
            applyFilters();
          } else {
            // @ts-ignore
            document.startViewTransition(() => applyFilters());
          }
        }, 150);
      });
    });

    // Setup inicial
    const firstBtn = buttons[0] as HTMLElement;
    if(firstBtn) {
        firstBtn.classList.add('border-neon-green', 'bg-neon-green/10');
        firstBtn.querySelector('span')?.classList.replace('text-white/50', 'text-neon-green');
    }
  };

  document.addEventListener('astro:page-load', initFilters);
</script>

<style is:global>
  /* Tus estilos previos se mantienen igual */
  @keyframes slide-in {
    from { opacity: 0; transform: translateX(-25px); }
    to { opacity: 1; transform: translateX(0); }
  }
  @keyframes fade-up {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-slide-in { animation: slide-in 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
  .animate-fade-up { animation: fade-up 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
  .hidden-instant { display: none !important; }
</style>