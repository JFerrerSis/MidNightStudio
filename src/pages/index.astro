---
import Layout from '../layouts/Layout.astro';
import LinkCard from '../components/ui/LinkCard.astro';
import Header from '../components/ui/Header.astro';
import Particles from '../components/ui/ParticlesBackground.astro';

// Importamos los iconos de Lucide
import { ShoppingBag, MessageCircle, Instagram, ExternalLink } from 'lucide-astro';

const phone = import.meta.env.PUBLIC_WHATSAPP_NUMBER;
const message = "¡Hola MidNight! 🌙 Me gustaría obtener información sobre sus servicios.";
const whatsappUrl = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
---

<Layout title="MidNight Studio | Links">
  <Particles />

  <div 
    class="flex flex-col items-center justify-center min-h-[90vh] max-w-112.5 mx-auto px-6 relative z-10 py-20"
    transition:animate="fade"
  >
    
    <div class="mb-12 text-center animate-fade-in">
        <Header />

    </div>

    <div class="w-full space-y-4 animate-slide-up">
      
      <LinkCard 
        title="Catálogo Digital" 
        href="/catalogo" 
        isPrimary={true}
      >
        <ShoppingBag slot="icon" size={20} strokeWidth={2.5} />
      </LinkCard>
      
     <LinkCard 
        title="WhatsApp" 
        href={whatsappUrl} 
      >
        <MessageCircle slot="icon" size={20} strokeWidth={2} class="text-emerald-400" />
      </LinkCard>

      <LinkCard 
        title="Instagram"
        href="https://www.instagram.com/midnighttstudio/" 
        
      >
        <Instagram slot="icon" size={20} strokeWidth={2} class="text-pink-500" />
      </LinkCard>

      <div class="pt-8 w-full flex justify-center">
        <div class="h-px w-12 bg-white/10"></div>
      </div>
      

    </div>

  </div>
</Layout>

<style is:global>
  /* Animaciones específicas para la entrada de la lista de links */
  @keyframes slideUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .animate-slide-up {
    animation: slideUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .animate-fade-in {
    animation: quickFade 1s ease-out forwards;
  }

  @keyframes quickFade {
    from { opacity: 0; }
    to { opacity: 1; }
  }
</style>